# --- Database Postgres (Neon) ---
# Su Vercel viene impostata automaticamente collegando il database Neon dal pannello Storage.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Login (Better Auth) ---
# Stringa casuale lunga: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pubblico del sito (su Vercel viene ricavato automaticamente)
# BETTER_AUTH_URL=http://localhost:3000

# --- AI per il riconoscimento delle foto (solo server) ---
ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-opus-5-5

# --- API nutrizionali (solo server) ---
# USDA FoodData Central, chiave gratuita: https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=
OFF_USER_AGENT=FitTrackAI/1.0 (tuo-sito.example)
