# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) oppure la vecchia anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- AI per il riconoscimento delle foto (solo server, mai esposta al browser) ---
ANTHROPIC_API_KEY=sk-ant-xxx
# Facoltativo: modello da usare (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# --- API nutrizionali (solo server) ---
# USDA FoodData Central, chiave gratuita: https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=
# Open Food Facts non richiede chiavi; chiede un User-Agent identificativo.
OFF_USER_AGENT=FitTrackAI/1.0 (tuo-sito.example)
