# Porta del server
PORT=8080
# Fonti eventi (almeno una per avere la sezione eventi attiva)
TICKETMASTER_API_KEY=
PREDICTHQ_TOKEN=
# Firma dei token di accesso (se vuoto viene generata e salvata nel database)
CD_AUTH_SECRET=
# Identificazione verso le API OSM/Wikimedia (richiesta dalle loro policy)
CD_USER_AGENT=CityDiscover/1.0 (+https://tuo-sito.example)
CD_CONTACT_EMAIL=
# Percorso del database SQLite
CD_DB_FILE=./data/citydiscover.db
# Aggiornamento automatico delle città cercate di recente (minuti, 0 = disattivato)
CD_REFRESH_MINUTES=60
# Recensioni minime per mostrare un voto
CD_MIN_REVIEWS=3
