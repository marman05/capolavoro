# --- Server ---
PORT=8787
# Chiave a 32 byte (base64) per cifrare a riposo le sessioni Open Banking lato server.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_ENCRYPTION_KEY=
# Token opzionale richiesto dal frontend per chiamare l'API locale (header Authorization: Bearer ...)
APP_ACCESS_TOKEN=
# Origine consentita dal CORS / redirect
PUBLIC_APP_URL=http://localhost:5173

# --- Enable Banking (Open Banking PSD2, AIS sola lettura) ---
# Registra un'applicazione su https://enablebanking.com (control panel) e scarica la chiave privata.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=./enablebanking.pem
# Deve coincidere con il redirect URL registrato nell'app Enable Banking
ENABLE_BANKING_REDIRECT_URL=http://localhost:5173/connessioni/callback

# --- AI Financial Assistant (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
